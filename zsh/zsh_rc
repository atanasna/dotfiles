##########################################
# Includes
##########################################
source ~/.config/zsh/aliases 2> /dev/null
source ~/.config/zsh/custom 2> /dev/null
source ~/.config/zsh/secrets 2> /dev/null

##########################################
# Prompt
##########################################
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="atanasna"
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)
source $ZSH/oh-my-zsh.sh

##########################################
# Tools
##########################################
# fzf for fuzzy history
source <(fzf --zsh)

# Zoxide for quick change dir
eval "$(zoxide init zsh)"

# Mise-en-place
eval "$(mise activate zsh --shims)"

