###########################################
# Completion
###########################################
autoload -Uz compinit
compinit -C -d "$HOME/.zcompdump"

###########################################
# Prompt
###########################################
eval "$(starship init zsh)"

###########################################
# Plugins
###########################################
source "$HOME/.oh-my-zsh/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" 2> /dev/null
source "$HOME/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" 2> /dev/null

###########################################
# Includes
###########################################
source ~/.config/zsh/aliases 2> /dev/null
source ~/.config/zsh/custom 2> /dev/null
source ~/.config/zsh/secrets 2> /dev/null

###########################################
# Tools
###########################################
# fzf for fuzzy history
if [[ -t 0 && -t 1 ]]; then
  source <(fzf --zsh)
fi

# Zoxide for quick change dir
eval "$(zoxide init zsh)"

# Mise-en-place
eval "$(mise activate zsh --shims)"

export JAVA_HOME=/Users/atanasna/.local/share/mise/installs/java/26.0.0/bin/java
