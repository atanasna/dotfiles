###########################################
# Aliases
###########################################
alias ll="eza -alah"
alias cat="bat --style=plain"
alias grep="rg"
alias find="fd"
alias vim="nvim"
alias k="kubectl"
alias oc="opencode"

tmux() {
    local session="default"
    if command tmux has-session -t="$session" 2>/dev/null; then
        command tmux attach -t "$session"
    else
        command tmux new-session -s "$session"
    fi
}
