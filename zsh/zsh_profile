#######################
# Includes
#######################
source ~/.config/zsh/paths 2> /dev/null

###########################################
# Customizations
###########################################
# Basic
export TERM=xterm-256color
export EDITOR=nvim

# History
HISTSIZE=10000
HISTFILESIZE=10000
setopt HIST_IGNORE_ALL_DUPS
setopt INC_APPEND_HISTORY
setopt SHARE_HISTORY
